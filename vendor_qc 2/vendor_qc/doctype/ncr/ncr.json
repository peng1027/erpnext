{
  "doctype": "DocType",
  "name": "NCR",
  "module": "Vendor QC",
  "autoname": "format:NCR-{######}",
  "editable_grid": 0,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "project",
      "label": "Project",
      "fieldtype": "Link",
      "options": "Project"
    },
    {
      "fieldname": "site",
      "label": "Site",
      "fieldtype": "Link",
      "options": "Contractor Site",
      "in_list_view": 1
    },
    {
      "fieldname": "supplier",
      "label": "Supplier",
      "fieldtype": "Link",
      "options": "Supplier",
      "in_list_view": 1
    },
    {
      "fieldname": "severity",
      "label": "Severity",
      "fieldtype": "Select",
      "options": "Low\\nMedium\\nHigh",
      "default": "Medium",
      "in_list_view": 1
    },
    {
      "fieldname": "due_date",
      "label": "Due Date",
      "fieldtype": "Date",
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Open\\nUnder Review\\nClosed\\nCancelled",
      "default": "Open",
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "photos",
      "label": "Photos",
      "fieldtype": "Table",
      "options": "NCR Photo"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "create": 1,
      "read": 1,
      "write": 1,
      "delete": 1
    },
    {
      "role": "Inspector",
      "create": 1,
      "read": 1,
      "write": 1
    },
    {
      "role": "Supplier Supervisor",
      "read": 1,
      "write": 1
    }
  ]
}